{
  "name": "belajar-vibecoding2",
  "version": "1.0.0",
  "description": "Backend Bun + ElysiaJS + Drizzle ORM + MySQL",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.1",
    "elysia": "^1.3.1",
    "mysql2": "^3.11.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.1"
  }
}
